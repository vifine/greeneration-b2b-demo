[Unit]
Description=Greeneration portal: login/session service (127.0.0.1:8089, behind Caddy /auth/*)
After=network.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/greeneration-portal
# PORTAL_SESSION_SECRET comes from here (generated by install.sh).
EnvironmentFile=/etc/greeneration-portal/env
Environment=PORTAL_AUTH_HOST=127.0.0.1 PORTAL_AUTH_PORT=8089 PORTAL_HTPASSWD=/etc/greeneration-portal/web-auth/htpasswd PYTHONUNBUFFERED=1
ExecStart=/opt/greeneration-portal/.venv/bin/python /opt/greeneration-portal/deploy/auth/portal_auth.py
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
