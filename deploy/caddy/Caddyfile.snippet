# Add to the Caddyfile and reload Caddy (`caddy reload` or restart the container).
# HTTPS certificate is issued automatically. Password is asked by portal-web (basic auth).
# Caddy running in Docker: replace 127.0.0.1 with host.docker.internal (and add
#   extra_hosts: ["host.docker.internal:host-gateway"]  to the Caddy service).
b2b.greeneration.ae {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 127.0.0.1:8088
}

# Alternative without the portal-web container (Caddy serves the files and asks the password).
# Hashes come from:  caddy hash-password   (type the password, never commit the result)
# b2b.greeneration.ae {
# 	root * /var/www/greeneration-portal/current
# 	basic_auth {
# 		vifine767@gmail.com <hash>
# 		levkova@greeneration.ae <hash>
# 		nikolaychik@greeneration.ae <hash>
# 	}
# 	header X-Robots-Tag "noindex, nofollow"
# 	try_files {path} /index.html
# 	file_server
# }
